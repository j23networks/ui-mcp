# Ubiquiti MCP — copy to .env and fill in. Each API is independent; only set the
# ones you use. Tools for an unconfigured API are not registered.

# --- Network API (local controller) ---
# API key: Network app -> Settings -> Integrations -> Create API Key
UBIQUITI_NETWORK_API_KEY=
# Controller base URL, including the integration path is NOT needed (added automatically).
# Use the console's IP/hostname, e.g. https://192.168.1.1
UBIQUITI_NETWORK_BASE_URL=https://192.168.1.1
# Local controllers use self-signed certs; set false to skip TLS verification.
UBIQUITI_NETWORK_VERIFY_TLS=false

# --- Site Manager API (cloud) [Phase 2] ---
# API key from unifi.ui.com
UBIQUITI_SITE_MANAGER_API_KEY=
UBIQUITI_SITE_MANAGER_BASE_URL=https://api.ui.com

# --- Protect API (local NVR) [Phase 3] ---
UBIQUITI_PROTECT_API_KEY=
UBIQUITI_PROTECT_BASE_URL=
UBIQUITI_PROTECT_VERIFY_TLS=false
